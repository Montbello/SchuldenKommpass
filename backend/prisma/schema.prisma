generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADVISOR
  ADMIN
  INSTITUTION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DocumentCategory {
  PROOF_MEDICAL
  PROOF_FINANCIAL
  PROOF_IDENTITY
  PROOF_OTHER
  TASK_PROOF
  GENERAL
}

enum OrgType {
  JOBCENTER
  SCHULDNERBERATUNG
  NGO
  PARTNER
  OTHER
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
  FOLLOWUP
}

model User {
  user_id      String     @id @default(uuid())
  name         String?
  email        String     @unique
  password_hash String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  date_of_birth DateTime?
  disabilities Json?
  
  // Onboarding & Consent
  onboarding_status OnboardingStatus @default(NOT_STARTED)
  stability_score   Float?           @default(0.0)
  referred_by       String?          // NGO/Jobcenter/Partner-ID
  user_story        String?          @db.Text
  consent_data_sharing Boolean @default(false)
  consent_data_processing Boolean @default(false)
  consent_partner_sharing Boolean @default(false)
  
  // Gamification & Unlocks
  level             Int      @default(1)
  total_points      Int      @default(0)
  unlocked_features Json?    // Array of feature keys
  
  // Institution Assignment (für Read-Only Zugriff)
  institution_id    String?
  
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  skills       Skill[]
  tasksCreated Task[]    @relation("TaskCreator")
  progresses   Progress[]
  appointments Appointment[] @relation("UserAppointments")
  advisorAppointments Appointment[] @relation("AdvisorAppointments")
  certificates Certificate[]
  documents    Document[]
  matches      Match[]       @relation("UserMatches")
  interactions Interaction[] // CRM: vom User erfasste Interaktionen
  reports      Report[]      // Vom User generierte Reports

  @@index([institution_id])
  @@index([onboarding_status])
  @@index([role])
  @@index([email])
}

model Skill {
  skill_id    String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [user_id])
  userId      String
  category    String
  description String?
  verified    Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([userId])
  @@index([category])
}

model Task {
  task_id        String        @id @default(uuid())
  title          String
  description    String?
  required_skill String?
  estimated_time Int?
  created_by     User?         @relation("TaskCreator", fields: [createdById], references: [user_id])
  createdById    String?
  organisation   Organisation? @relation(fields: [organisationId], references: [org_id])
  organisationId String?
  created_at     DateTime      @default(now())
  active         Boolean       @default(true)
  progresses     Progress[]
  matches        Match[]

  @@index([organisationId])
  @@index([active])
  @@index([required_skill])
}

model Progress {
  progress_id      String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [user_id])
  userId           String
  task             Task     @relation(fields: [taskId], references: [task_id])
  taskId           String
  status           String
  proof_document   Document? @relation(fields: [proofDocumentId], references: [document_id])
  proofDocumentId  String?
  points_earned    Int?     @default(0)
  updated_at       DateTime @updatedAt

  @@index([userId, status])
  @@index([taskId])
  @@index([updated_at])
}

model Appointment {
  appointment_id String   @id @default(uuid())
  user           User     @relation("UserAppointments", fields: [userId], references: [user_id])
  userId         String
  advisor        User?    @relation("AdvisorAppointments", fields: [advisorId], references: [user_id])
  advisorId      String?
  start_time     DateTime
  end_time       DateTime
  status         String
  video_link     String?

  @@index([userId])
  @@index([advisorId])
  @@index([start_time])
  @@index([status])
}

model Certificate {
  certificate_id String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [user_id])
  userId         String
  title          String
  description    String?
  issued_date    DateTime @default(now())
  valid_until    DateTime?
  signed_token   String?
  issued_by      String?

  @@index([userId])
  @@index([issued_date])
}

model Document {
  document_id   String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [user_id])
  userId        String
  file_path     String
  file_type     String
  file_hash     String?
  storage_provider String?
  encrypted     Boolean  @default(false)
  retention_expiry DateTime?
  uploaded_at   DateTime @default(now())
  description   String?
  
  // Onboarding & Categorization
  document_category DocumentCategory @default(GENERAL)
  verification_status String? // PENDING, VERIFIED, REJECTED
  verified_by       String? // User ID of verifier
  verified_at       DateTime?
  
  progresses    Progress[]

  @@index([userId])
  @@index([document_category])
  @@index([verification_status])
}

model Match {
  match_id   String   @id @default(uuid())
  user       User     @relation("UserMatches", fields: [userId], references: [user_id])
  userId     String
  task       Task     @relation(fields: [taskId], references: [task_id])
  taskId     String
  score      Float
  assigned_at DateTime @default(now())
  status     String

  @@index([userId])
  @@index([taskId])
  @@index([status])
}

model AuditEvent {
  id         String   @id @default(uuid())
  entity     String
  entity_id  String
  action     String
  payload    Json?
  created_at DateTime @default(now())
}

// ============================================
// CRM & Partner Models (Phase 2)
// ============================================

model Organisation {
  org_id         String    @id @default(uuid())
  name           String
  type           OrgType
  description    String?
  address        String?
  contact_email  String?
  contact_phone  String?
  website        String?
  api_token_hash String?   // für Partner-API Auth (hashed)
  webhook_url    String?   // für Callbacks
  webhook_secret String?   // HMAC secret für Webhook-Validierung
  rate_limit_per_hour Int? @default(100) // API Rate Limit
  active         Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  tasks          Task[]
  contacts       Contact[]
  reports        Report[]
}

model Contact {
  contact_id     String       @id @default(uuid())
  organisation   Organisation @relation(fields: [organisationId], references: [org_id])
  organisationId String
  name           String
  email          String?
  phone          String?
  position       String?      // z.B. "Sachbearbeiter", "Teamleitung"
  notes          String?
  primary        Boolean      @default(false)  // Hauptansprechpartner
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  interactions   Interaction[]
}

model Interaction {
  interaction_id String          @id @default(uuid())
  contact        Contact         @relation(fields: [contactId], references: [contact_id])
  contactId      String
  type           InteractionType
  subject        String
  content        String?
  outcome        String?         // Ergebnis/nächste Schritte
  followup_date  DateTime?
  created_at     DateTime        @default(now())
  created_by     User?           @relation(fields: [createdById], references: [user_id])
  createdById    String?
}

model Report {
  report_id      String        @id @default(uuid())
  type           String        // PARTICIPANT_PROGRESS, MASSNAHMENNACHWEIS, ORGANISATION_OVERVIEW
  organisation   Organisation? @relation(fields: [organisationId], references: [org_id])
  organisationId String?
  period_start   DateTime
  period_end     DateTime
  format         String        // PDF, XML, JSON
  file_path      String?
  generated_at   DateTime      @default(now())
  generated_by   User?         @relation(fields: [generatedById], references: [user_id])
  generatedById  String?
}
