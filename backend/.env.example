# Example environment variables for Schuldenkompass backend
# Copy to .env and fill the real values (DO NOT commit real secrets)

# JWT secret used to sign access tokens
JWT_SECRET=your-very-secure-random-secret

# Postgres DB connection URL (used by Prisma)
# Example (local Docker): postgresql://postgres:postgres@localhost:5432/schuldenkompass
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schuldenkompass

# Server port
PORT=3000

# Google Gemini API Key (required for report generation)
GEMINI_API_KEY=your-gemini-api-key

# Video Provider (daily or jitsi, default: jitsi)
VIDEO_PROVIDER=jitsi

# Daily.co API Key (optional, only if VIDEO_PROVIDER=daily)
# Get your key from: https://dashboard.daily.co/
DAILY_API_KEY=your-daily-api-key
